{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Atomic Strain",
            "key": "atomic-strain",
            "icon": "HiCube",
            "author": "Rodolfo Herrera",
            "license": "MIT",
            "version": "2.0.2",
            "homepage": "https://github.com/rodyherrera/Volterra",
            "description": "Calcula el tensor de deformacion atomica (deformation gradient, strain tensors, D2min) usando una configuracion de referencia."
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1392,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "executable",
            "binary": "atomic-strain",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "atomic-strain",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "primary-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Atomic Strain",
            "icon": "HiCube",
            "results": "atomic_strain.parquet",
            "iterable": ""
          }
        }
      },
      {
        "id": "atomic-strain-model-exposure",
        "type": "exposure",
        "position": {
          "x": 1712,
          "y": 336
        },
        "data": {
          "exposure": {
            "name": "Atomic Strain Model",
            "icon": "HiCube",
            "results": "atoms.parquet",
            "iterable": "",
            "properties": [
              {
                "key": "shear_strain",
                "label": "Shear Strain",
                "type": "double"
              },
              {
                "key": "volumetric_strain",
                "label": "Volumetric Strain",
                "type": "double"
              },
              {
                "key": "D2min",
                "label": "D\u00b2min (Nonaffine Displacement)",
                "type": "double"
              },
              {
                "key": "strain_tensor",
                "label": "Strain Tensor (6 components)",
                "type": "list<double>"
              },
              {
                "key": "deformation_gradient",
                "label": "Deformation Gradient (3\u00d73)",
                "type": "list<double>"
              },
              {
                "key": "rotation_tensor",
                "label": "Rotation Tensor (3\u00d73)",
                "type": "list<double>"
              },
              {
                "key": "stretch_tensor",
                "label": "Stretch Tensor (3\u00d73)",
                "type": "list<double>"
              },
              {
                "key": "invalid",
                "label": "Invalid Particle",
                "type": "bool"
              }
            ]
          }
        }
      },
      {
        "id": "atomic-strain-model-export",
        "type": "export",
        "position": {
          "x": 2032,
          "y": 336
        },
        "data": {
          "export": {
            "exporter": "AtomisticExporter",
            "type": "glb"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-context-foreach",
        "source": "trajectory-context",
        "sourceHandle": "output",
        "target": "foreach-trajectory-dumps",
        "targetHandle": "input"
      },
      {
        "id": "edge-foreach-entrypoint",
        "source": "foreach-trajectory-dumps",
        "sourceHandle": "output",
        "target": "analysis-entrypoint",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "primary-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-entrypoint-atomic-strain-model-exposure",
        "source": "analysis-entrypoint",
        "sourceHandle": "output",
        "target": "atomic-strain-model-exposure",
        "targetHandle": "input"
      },
      {
        "id": "edge-atomic-strain-model-exposure-atomic-strain-model-export",
        "source": "atomic-strain-model-exposure",
        "sourceHandle": "output",
        "target": "atomic-strain-model-export",
        "targetHandle": "input"
      },
      {
        "id": "edge-plugin-metadata-trajectory-context",
        "source": "plugin-metadata",
        "sourceHandle": "output",
        "target": "trajectory-context",
        "targetHandle": "input"
      }
    ]
  },
  "interface": {
    "version": 2,
    "provides": {
      "volt/per-atom-properties@1": {
        "atoms": "atoms.parquet"
      }
    }
  }
}
